<% layout("/layouts/boilerplate") %>
<link href="/css/home.css" rel="stylesheet" />
<link rel="stylesheet" href="/css/menu.css" />

<div class="inner-container">
  <div class="heading-container">
    <h1 class="heading-container-heading">Menu</h1>
  </div>
  <div class="menu-container">
    <h2>Snacks</h2>

    <div class="menu-items about-us-dishes">
      <% for (let recipie of recipies) { %>
        <% if (recipie.category == "Snacks") { %>
          <a href="/recipies/<%= recipie._id %>" class="recipie-link mt-3">
            <div class="card my-5 p-4">
              <img src="<%= recipie.image.url %>" class="card-img card-image" alt="image"/>
              <div class="card-body">
                <h5 class="card-title my-2"><%= recipie.name %></h5>
                <p class="price">&#8377;<%= recipie.price.toLocaleString("en-IN") %></p>
                <form method="post" action="addToCart/<%= recipie._id %>">
                  <button class="btn addCartBtn">Add to Cart</button>
                </form>
              </div>
            </div>
          </a>
        <% } %>
      <% } %>
    </div>
    <hr />
    
    <h2>Desert</h2>
