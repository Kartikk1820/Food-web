<% layout("/layouts/boilerplate") %>
<link href="/css/home.css" rel="stylesheet" />
<link rel="stylesheet" href="/css/menu.css" />

<div class="inner-container">
  <div class="heading-container">
    <h1 class="heading-container-heading">Menu</h1>
  </div>
  <div class="menu-container">
    <h2>Snacks</h2>

    <div class="menu-items about-us-dishes">
      <%for(recipie of recipies){ %> <%if(recipie.category == "Snacks") { %>
      <a href="/recipies/<%=recipie._id%>" class="recipie-link mt-3">
        <div class="card my-5 p-4">
          <img
            src="<%=recipie.image.url%>"
            class="card-img card-image"
            alt="image"
          />
          <div class="card-body">
            <h5 class="card-title my-2"><%=recipie.name %></h5>
            <p class="price">
              &#8377;<%=recipie.price.toLocaleString("en-IN") %>
            </p>
            <button class="btn addCartBtn">Add to Cart</button>
          </div>
        </div>
      </a>
      <%} } %>
    </div>
    <hr />
    <h2>Desert</h2>

    <div class="menu-items about-us-dishes">
      <%for(recipie of recipies){ %> <%if(recipie.category == "Desert") { %>
      <a href="/recipies/<%=recipie._id%>" class="recipie-link mt-3">
        <div class="card my-5 p-4">
          <img
            src="<%=recipie.image.url%>"
            class="card-img card-image"
            alt="image"
          />
          <div class="card-body">
            <h5 class="card-title my-2"><%=recipie.name %></h5>
            <p class="price">
              &#8377;<%=recipie.price.toLocaleString("en-IN") %>
            </p>
            <button class="btn addCartBtn">Add to Cart</button>
          </div>
        </div>
      </a>
      <%} } %>
    </div>
    <hr />
    <h2>Juices</h2>

    <div class="menu-items about-us-dishes">
      <%for(recipie of recipies){ %> <%if(recipie.category == "Juices") { %>
      <a href="/recipies/<%=recipie._id%>" class="recipie-link mt-3">
        <div class="card my-5 p-4">
          <img
            src="<%=recipie.image.url%>"
            class="card-img card-image"
            alt="image"
          />
          <div class="card-body">
            <h5 class="card-title my-2"><%=recipie.name %></h5>
            <p class="price">
              &#8377;<%=recipie.price.toLocaleString("en-IN") %>
            </p>
            <button class="btn addCartBtn">Add to Cart</button>
          </div>
        </div>
      </a>
      <%} } %>
    </div>
    <hr />
    <h2>Indian Thali</h2>

    <div class="menu-items about-us-dishes">
      <%for(recipie of recipies){ %> <%if(recipie.category == "Indian Thali") {
      %>
      <a href="/recipies/<%=recipie._id%>" class="recipie-link mt-3">
        <div class="card my-5 p-4">
          <img
            src="<%=recipie.image.url%>"
            class="card-img card-image"
            alt="image"
          />
          <div class="card-body">
            <h5 class="card-title my-2"><%=recipie.name %></h5>
            <p class="price">
              &#8377;<%=recipie.price.toLocaleString("en-IN") %>
            </p>
            <button class="btn addCartBtn">Add to Cart</button>
          </div>
        </div>
      </a>
      <%} } %>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll(".addCartBtn").forEach((button) => {
    button.addEventListener("click", function () {
      console.log("hello");
      const recipeId = this.getAttribute("data-recipe-id");

      fetch(`/add-to-cart/${recipeId}`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ recipeId: recipeId }),
      })
        .then((response) => response.json())
        .then((data) => {
          if (data.success) {
            alert("Recipe added to cart!");
          } else {
            if (data.redirect) {
              window.location.href = data.redirect;
            } else {
              alert(data.message);
            }
          }
        })
        .catch((error) => console.error("Error:", error));
    });
  });
</script>
