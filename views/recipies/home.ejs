<% layout("/layouts/boilerplate.ejs") -%>
<link href="/css/home.css" rel="stylesheet" />

<div class="inner-container">
  <section class="bg-img-container">
    <div class="image-text">
      <div class="image-text-first">AMAZING & DELICIOUS</div>
      <div class="image-text-second mt-4">
        Where every flavour tells a story
      </div>
      <div class="image-text-third mt-4">
        Come with family and feel the joy of mouthwatering food
      </div>
    </div>
  </section>
  <section class="about-us">
    <div class="move">
      <div class="marque">
        <h1 class="poppins-light">
          Get <span> 30% OFF </span> on your first order!
        </h1>
        <h1 class="poppins-light">
          Get <span> 30% OFF </span> on your first order!
        </h1>
        <h1 class="poppins-light">
          Get <span> 30% OFF </span> on your first order!
        </h1>
      </div>
    </div>
    <div class="about-us-heading mt-5">
      <h1>
        "Saves the Flavour: Discover What Sets Our Restaurant's Cusine Apart!"
      </h1>
    </div>
    <div class="about-us-dishes mt-3">
      <div class="card my-5 p-4">
        <img
          src="https://mybayutcdn.bayut.com/mybayut/wp-content/uploads/jumeirah-beach-hotel-_-Body-11-10-2-23.jpg"
          class="card-img"
          alt="image"
        />
        <div class="card-body">
          <h5 class="card-title my-2">Authentic Indian Flavour</h5>
          <p class="card-text">
            From aromatic curries to flavorful biryanis, our menu showcases the
            diversity and deliciousness of Indian cuisine.
          </p>
        </div>
      </div>
      <div class="card my-5 p-4">
        <img
          src="https://i.pinimg.com/originals/e5/54/27/e5542795e274c9be794a739ad3b0598e.jpg"
          class="card-img"
          alt="Image"
        />
        <div class="card-body">
          <h5 class="card-title my-2">Tech Infused Dining Experience</h5>
          <p class="card-text">
            Customers can use apps to place orders, customize their dishes, and
            even provide feedback, making their visit more convenient and
            interactive.
          </p>
        </div>
      </div>
      <div class="card my-5 p-4">
        <img
          src="https://i.pinimg.com/736x/aa/7c/58/aa7c58725db1ab91c522c7dd0994e37b.jpg"
          class="card-img"
          alt="Image"
        />

        <div class="card-body">
          <h5 class="card-title my-2">Inovative Fusion Dishes</h5>
          <p class="card-text">
            Some quick example text to build on the card title and make up the
            bulk of the card's content.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="services-container mt-5">
    <div class="services">
      <div class="box-main my-3">
        <div class="card-body">
          <h5 class="box-card-title card-title">Bringing Happiness To You</h5>

          <p class="box-card-text card-text">
            Food is more than substance; It's a source of pure happiness. From
            the first bite of favourite childhood dish to the thrill of
            discovering new flavour, food has a unique way of filling our hearts
            with joy.
          </p>
        </div>
      </div>
      <div class="box services-online-delivery my-3">
        <div class="box-text online-delivery-heading">Online Delivery</div>
        <button class="btn box-border-text">Order Online</button>
      </div>
      <div class="box services-take-order my-3">
        <div class="box-text online-delivery-heading">Click & Collect</div>
        <button class="btn box-border-text">Take Out Order</button>
      </div>
      <div class="box services-book-table my-3">
        <div class="box-text online-delivery-heading">Restaurant Dining</div>
        <button class="btn box-border-text">Book Table</button>
      </div>
    </div>
  </section>
  <section class="menu-container pt-5">
    <div class="mainhead">
      <h1 class="mainhead-heading my-2">
        "Get ready to explore our delicious range of dishes!"
      </h1>
      <p class="mainhead-text my-2">
        "Welcome to a world of culinary delights where every bite tells a
        flavorful story. Explore our diverse menu and savor the essence of
        exquisite dining."
      </p>
      <a href="/recipies" class="view-btn my-2"
        ><button class="btn">View Menu</button></a
      >
    </div>
    <div class="menu-items about-us-dishes">
      <div class="card my-5 p-4">
        <img
          src="https://mybayutcdn.bayut.com/mybayut/wp-content/uploads/jumeirah-beach-hotel-_-Body-11-10-2-23.jpg"
          class="card-img"
          alt="image"
        />
        <div class="card-body">
          <h5 class="card-title my-2">Indian Thali</h5>
          <p class="card-text">
            Enjoy a thali full of traditional flavours and memotries
          </p>
        </div>
      </div>
      <div class="card my-5 p-4">
        <img
          src="https://mybayutcdn.bayut.com/mybayut/wp-content/uploads/jumeirah-beach-hotel-_-Body-11-10-2-23.jpg"
          class="card-img"
          alt="image"
        />
        <div class="card-body">
          <h5 class="card-title my-2">Dessert</h5>
          <p class="card-text">
            Complete your meal with mouth watering delicacies
          </p>
        </div>
      </div>
      <div class="card my-5 p-4">
        <img
          src="https://mybayutcdn.bayut.com/mybayut/wp-content/uploads/jumeirah-beach-hotel-_-Body-11-10-2-23.jpg"
          class="card-img"
          alt="image"
        />
        <div class="card-body">
          <h5 class="card-title my-2">Snacks</h5>
          <p class="card-text">
            Have a lighter version with delicious flavours
          </p>
        </div>
      </div>
      <div class="card my-5 p-4">
        <img
          src="https://mybayutcdn.bayut.com/mybayut/wp-content/uploads/jumeirah-beach-hotel-_-Body-11-10-2-23.jpg"
          class="card-img"
          alt="image"
        />
        <div class="card-body">
          <h5 class="card-title my-2">Juices</h5>
          <p class="card-text">Boost yourself up with fruits extracts</p>
        </div>
      </div>
    </div>
  </section>
</div>
